#!/usr/bin/env ruby
# git-import-all

# 20260824
# 0.15.1

# Notes:
# 1. For the time being this will use the same directory as is used by clone.
# 2. Optionally run changelogger on the revisions root before running this script.

# Todo:
# 1. Accommodate for when there is a local repository, but none remotely, since that is a possibility. (Done as of 0.4.0; essentially by removing any reference to a remote repository at all.)
# 2. Make the output a bit more presentable.
# 3. As per git-boot (to an extent) make this independent of Github and able to be used with other similar services as well as with generic git repo's.  (Done as of 0.4.0 as per Todo #1.)

# Examples:
# 1. cd ~/path/to/repo; git-import-all ~/path/to/revisions/root/
# 2. git-import-all ~/path/to/repo ~/path/to/revisions/root/

require 'date'
require 'Kernel/run'
require 'shellwords'

module Changelog
  ITEM = /\A\d+\.\s+(.*)\z/
  VERSION = /\[?v?(\d+(?:\.\d+)+)\]?/
  DATE = /(\d{4}-?\d{2}-?\d{2})/

  module Format
    module Common
      def heading(text)
        text.lines.first.to_s.strip
      end

      def body_lines(text)
        text.lines.drop(1).map(&:strip)
      end

      def items(text)
        body_lines(text).map{|line| line[Changelog::ITEM, 1]}.compact
      end

      def entry(version, date, summary, text)
        {version: version, date: date, summary: summary || items(text).first || 'No summary'}
      end
    end

    module DatedHeading
      extend Common

      BOUNDARY = /^##\s+\d{8}\s*$/
      HEADING = /\A##\s+(\d{8})\s*\z/
      VERSIONED_SUMMARY = /\A(\d+(?:\.\d+)+)(?::\s*(.*))?\z/

      class << self
        def key
          :dated_heading
        end

        def matches?(text)
          !(heading(text) =~ HEADING).nil?
        end

        # A heading may stand over more than one version, changelogger writing one
        # heading per date as of 0.10.0 rather than one per version.  Each versioned
        # summary beneath a heading begins an entry and they share its date; a
        # heading with one version beneath it is a run of one, so the older form
        # parses exactly as before.
        def parse(text)
          date = heading(text)[HEADING, 1]
          blocks = versioned_blocks(text)
          return [unversioned_entry(text, date)] if blocks.empty?
          blocks.collect{|block| entry(block[:version], date, block[:summary], block[:text])}
        end

        private

        # Each block's text begins with its own summary line, so that the items
        # beneath it are what entry() reads where no summary was stated.
        # A version line need not carry a summary: changelogger writes it bare where
        # the revision it read had no marker to take one from.  Bare, the entry takes
        # its first item instead, which is what entry() does with a nil summary.
        def versioned_blocks(text)
          body_lines(text).each_with_object([]) do |line, blocks|
            if line =~ VERSIONED_SUMMARY
              summary = $2.to_s.strip
              blocks << {version: $1, summary: (summary.empty? ? nil : summary), text: "#{line}\n"}
            elsif !blocks.empty?
              blocks.last[:text] += "#{line}\n"
            end
          end
        end

        def unversioned_entry(text, date)
          summary = body_lines(text).detect do |line|
            !line.empty? && !(line =~ Changelog::ITEM) && !line.start_with?('#')
          end
          entry(nil, date, summary, text)
        end
      end
    end

    module VersionedHeading
      extend Common

      BOUNDARY = /^##\s+\[?v?\d+(?:\.\d+)+/

      class << self
        def key
          :versioned_heading
        end

        def matches?(text)
          line = heading(text)
          line.start_with?('##') && !line[Changelog::VERSION, 1].nil?
        end

        def parse(text)
          line = heading(text).sub(/\A##\s+/, '')
          version = line[Changelog::VERSION, 1]
          date = line[Changelog::DATE, 1]
          [entry(version, date, summary(line, version, date) || trailing_summary(text), text)]
        end

        private

        def summary(line, version, date)
          result = line.dup
          result.sub!(/\[?v?#{Regexp.escape(version)}\]?/, '') if version
          result.sub!(/\(?#{Regexp.escape(date)}\)?/, '') if date
          result.sub!(/\A[\s\-—\/(),:]+/, '')
          result.strip.empty? ? nil : result.strip
        end

        def trailing_summary(text)
          line = body_lines(text).detect{|candidate| !candidate.empty? && !(candidate =~ Changelog::ITEM)}
          line ? line.sub(/\A#+\s*/, '').strip[/.+/] : nil
        end
      end
    end

    class << self
      def all
        [DatedHeading, VersionedHeading]
      end

      def boundary
        @boundary ||= Regexp.new("(?=#{all.map{|format| format::BOUNDARY.source}.join('|')})")
      end

      def for(text)
        matched = all.select{|format| format.matches?(text)}
        line = text.lines.first.to_s.strip
        raise "No CHANGELOG format matches: #{line}" if matched.empty?
        raise "Ambiguous CHANGELOG format (#{matched.map(&:key).join(', ')}): #{line}" if matched.length > 1
        matched.first
      end
    end
  end

  class << self
    def parse(text)
      return [] unless text
      # Flattened in the order the file states them, newest first, and reversed
      # once at the end: a heading standing over several versions holds them in
      # that same order, so reversing the chunks alone left those in the wrong one.
      chunks(text).flat_map{|chunk| Format.for(chunk).parse(chunk)}.reverse
    end

    private

    def chunks(text)
      result = text.split(Format.boundary).reject{|chunk| chunk.strip.empty?}
      result.shift unless result.empty? || matched?(result.first)
      raise 'No CHANGELOG entries recognised.' if result.empty?
      result
    end

    def matched?(chunk)
      Format.all.any?{|format| format.matches?(chunk)}
    end
  end
end

def second_argument?
  !ARGV[1].nil?
end

def revisions_root
  @revisions_root ||= (
    if second_argument?
      if ARGV[1] && File.exist?(ARGV[1])
        File.expand_path(ARGV[1])
      end
    elsif ARGV[0] && File.exist?(ARGV[0])
      File.expand_path(ARGV[0])
    end
  )
end

def revision_directories
  Dir["#{revisions_root}/*"]
    .select{|entry| File.directory?(entry) && File.basename(entry) =~ /\A\d+\z/}
    .sort_by{|entry| File.basename(entry).to_i}
    .map{|entry| File.expand_path(entry)}
end

def repo
  @repo ||= (
    if second_argument?
      if ARGV[0] && File.exist?(ARGV[0])
        File.expand_path(ARGV[0])
      end
    else
      File.expand_path('.')
    end
  )
end

def repository_exist?(repo)
  current_dir = Dir.pwd
  return_value = Dir.exist?(repo) && Dir.chdir(repo) && Dir.exist?('.git')
  Dir.chdir(current_dir)
  return_value
end

def read_changelog(sorted_revisions)
  sorted_revisions.reverse_each do |candidate|
    ['CHANGELOG.md', 'CHANGELOG'].each do |filename|
      changelog_path = File.join(candidate, filename)
      return File.read(changelog_path) if File.exist?(changelog_path)
    end
  end
  nil
end

def commit_message(revision_index, entries)
  entry = entries[revision_index]
  if entry
    prefix = entry[:version] || entry[:date]
    if prefix
      "#{prefix}: #{entry[:summary]}"
    else
      entry[:summary]
    end
  else
    "Committed automatically by git-import-all."
  end
end

def commit_date(revision_index, entries)
  entry = entries[revision_index]
  return nil unless entry && entry[:date]
  date = Date.parse(entry[:date]) rescue nil
  date&.to_time&.strftime('%Y-%m-%dT%H:%M:%S%z')
end

# The author date is when the work was authored, which a CHANGELOG knows to the
# day, midnight saying the day is known and the hour is not.  The committer date
# is when the commit was made, which is now: stamping it with the CHANGELOG's
# date states that a commit was made upon a day it was not, sometimes years
# earlier.  Left unset, git takes the time of the commit, which is what every
# other rewrite does — filter-branch, rebase, am and cherry-pick each keep the
# author date and take a fresh committer date.
#
# The cost is that an import is no longer reproducible: run twice over the same
# revisions it now yields different commits, where before it yielded the same
# ones.  A switch could have that back where it is ever wanted; a false date by
# default is too much to pay for it.
def commit_environment(revision_index, entries)
  date = commit_date(revision_index, entries)
  return '' unless date
  "GIT_AUTHOR_DATE=#{date} "
end

def check_entry_count!(sorted_revisions, entries)
  return if entries.length == sorted_revisions.length
  raise "#{entries.length} CHANGELOG entries for #{sorted_revisions.length} revisions: " \
    'each revision takes its message from the entry at the same index, so the two must agree.'
end

def main(repo)
  unless repository_exist?(repo)
    $stderr.puts "#{repo} is not a git repository."
    $stderr.puts 'Make one first, with git init or git-boot: this imports into a repository, it does not create one.'
    exit 1
  end
  sorted_revisions = revision_directories
  changelog_text = read_changelog(sorted_revisions)
  entries = Changelog.parse(changelog_text)
  check_entry_count!(sorted_revisions, entries)
  sorted_revisions.each_with_index do |revision, index|
    Dir["#{repo}/*"].each do |filename|
      run "rm -rf #{filename}", show: true
    end
    Dir["#{revision}/*"].each do |filename|
      run "cp -r #{filename} #{repo}", show: true
    end
    message = commit_message(index, entries)
    run 'git add -A', show: true
    run "#{commit_environment(index, entries)}git commit -m #{Shellwords.escape(message)}", show: true
  end
end

main(repo)
