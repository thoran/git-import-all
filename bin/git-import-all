#!/usr/bin/env ruby
# git-import-all

# 20261030
# 0.17.0

# Notes:
# 1. For the time being this will use the same directory as is used by clone.
# 2. Optionally run changelogger on the revisions root before running this script.
# 3. Where the revisions root holds a revisions.yml, each commit's message and author date are taken from it and no CHANGELOG is read.

# Todo:
# 1. Accommodate for when there is a local repository, but none remotely, since that is a possibility. (Done as of 0.4.0; essentially by removing any reference to a remote repository at all.)
# 2. Make the output a bit more presentable.
# 3. As per git-boot (to an extent) make this independent of Github and able to be used with other similar services as well as with generic git repo's.  (Done as of 0.4.0 as per Todo #1.)

# Examples:
# 1. cd ~/path/to/repo; git-import-all ~/path/to/revisions/root/
# 2. git-import-all ~/path/to/repo ~/path/to/revisions/root/
# 3. git-import-all ~/path/to/repo ~/path/to/revisions/root/, where ~/path/to/revisions/root/revisions.yml states each commit.

require 'date'
require 'Kernel/run'
require 'shellwords'
require 'tempfile'
require 'yaml'

module Changelog
  ITEM = /\A\d+\.\s+(.*)\z/
  VERSION = /\[?v?(\d+(?:\.\d+)+)\]?/
  DATE = /(\d{4}-?\d{2}-?\d{2})/

  module Format
    module Common
      def heading(text)
        text.lines.first.to_s.strip
      end

      def body_lines(text)
        text.lines.drop(1).map(&:strip)
      end

      def items(text)
        body_lines(text).map{|line| line[Changelog::ITEM, 1]}.compact
      end

      def entry(version, date, summary, text)
        {version: version, date: date, summary: summary || items(text).first || 'No summary'}
      end
    end

    module DatedHeading
      extend Common

      BOUNDARY = /^##\s+\d{8}\s*$/
      HEADING = /\A##\s+(\d{8})\s*\z/
      VERSIONED_SUMMARY = /\A(\d+(?:\.\d+)+)(?::\s*(.*))?\z/

      class << self
        def key
          :dated_heading
        end

        def matches?(text)
          !(heading(text) =~ HEADING).nil?
        end

        # A heading may stand over more than one version, changelogger writing one
        # heading per date as of 0.10.0 rather than one per version.  Each versioned
        # summary beneath a heading begins an entry and they share its date; a
        # heading with one version beneath it is a run of one, so the older form
        # parses exactly as before.
        def parse(text)
          date = heading(text)[HEADING, 1]
          found = blocks(text)
          return [unversioned_entry(text, date)] if found.empty?
          found.collect{|block| entry(block[:version], date, block[:summary], block[:text])}
        end

        private

        # Each block's text begins with its own summary line, so that the items
        # beneath it are what entry() reads where no summary was stated.
        # A version line need not carry a summary: changelogger writes it bare where
        # the revision it read had no marker to take one from.  Bare, the entry takes
        # its first item instead, which is what entry() does with a nil summary.
        #
        # An entry begins at a line stating a version, as it always has, and also
        # after the two blank lines changelogger writes between one entry and the
        # next, so that an entry stating no version is an entry of its own rather
        # than part of the one above it.  changelogger 0.19.0 writes such an entry
        # for a snapshot, a revision whose header states neither a new version nor
        # a new item; before this a tree holding snapshots parsed to fewer entries
        # than it had revisions, and the import refused it.
        def blocks(text)
          separated = true
          blanks = 0
          body_lines(text).each_with_object([]) do |line, blocks|
            if line.empty?
              blanks += 1
              separated = true if blanks > 1
              blocks.last[:text] += "\n" unless blocks.empty?
              next
            end
            if line =~ VERSIONED_SUMMARY
              summary = $2.to_s.strip
              blocks << {version: $1, summary: (summary.empty? ? nil : summary), text: "#{line}\n"}
            elsif separated
              # An entry whose first line is itself an item takes that item as its
              # summary, stated here rather than left to entry(): items() reads a
              # text's lines after its first, that first being a summary line, and
              # would pass over the very item this block begins at.
              summary = line =~ Changelog::ITEM ? $1 : line
              blocks << {version: nil, summary: summary, text: "#{line}\n"}
            else
              blocks.last[:text] += "#{line}\n"
            end
            blanks = 0
            separated = false
          end
        end

        def unversioned_entry(text, date)
          summary = body_lines(text).detect do |line|
            !line.empty? && !(line =~ Changelog::ITEM) && !line.start_with?('#')
          end
          entry(nil, date, summary, text)
        end
      end
    end

    module VersionedHeading
      extend Common

      BOUNDARY = /^##\s+\[?v?\d+(?:\.\d+)+/

      class << self
        def key
          :versioned_heading
        end

        def matches?(text)
          line = heading(text)
          line.start_with?('##') && !line[Changelog::VERSION, 1].nil?
        end

        def parse(text)
          line = heading(text).sub(/\A##\s+/, '')
          version = line[Changelog::VERSION, 1]
          date = line[Changelog::DATE, 1]
          [entry(version, date, summary(line, version, date) || trailing_summary(text), text)]
        end

        private

        def summary(line, version, date)
          result = line.dup
          result.sub!(/\[?v?#{Regexp.escape(version)}\]?/, '') if version
          result.sub!(/\(?#{Regexp.escape(date)}\)?/, '') if date
          result.sub!(/\A[\s\-—\/(),:]+/, '')
          result.strip.empty? ? nil : result.strip
        end

        def trailing_summary(text)
          line = body_lines(text).detect{|candidate| !candidate.empty? && !(candidate =~ Changelog::ITEM)}
          line ? line.sub(/\A#+\s*/, '').strip[/.+/] : nil
        end
      end
    end

    class << self
      def all
        [DatedHeading, VersionedHeading]
      end

      def boundary
        @boundary ||= Regexp.new("(?=#{all.map{|format| format::BOUNDARY.source}.join('|')})")
      end

      def for(text)
        matched = all.select{|format| format.matches?(text)}
        line = text.lines.first.to_s.strip
        raise "No CHANGELOG format matches: #{line}" if matched.empty?
        raise "Ambiguous CHANGELOG format (#{matched.map(&:key).join(', ')}): #{line}" if matched.length > 1
        matched.first
      end
    end
  end

  class << self
    def parse(text)
      return [] unless text
      # Flattened in the order the file states them, newest first, and reversed
      # once at the end: a heading standing over several versions holds them in
      # that same order, so reversing the chunks alone left those in the wrong one.
      chunks(text).flat_map{|chunk| Format.for(chunk).parse(chunk)}.reverse
    end

    private

    def chunks(text)
      result = text.split(Format.boundary).reject{|chunk| chunk.strip.empty?}
      result.shift unless result.empty? || matched?(result.first)
      raise 'No CHANGELOG entries recognised.' if result.empty?
      result
    end

    def matched?(chunk)
      Format.all.any?{|format| format.matches?(chunk)}
    end
  end
end

# A revisions.yml states each commit whole: the revision it describes, its
# author time and its message.  Any other key is provenance and is passed over.
# The whole file is checked before anything is committed, so that a file which
# is wrong anywhere commits nothing.
module Revisions
  FILENAME = 'revisions.yml'
  DAY = /\A\d{4}-\d{2}-\d{2}\z/
  TIME = /\A\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2} [+-]\d{4}\z/

  class Invalid < RuntimeError; end

  class << self
    def parse(text, sorted_revisions)
      entries = list(text)
      sorted_revisions.first(entries.length).each_with_index do |revision, index|
        check_entry!(entries[index], index, File.basename(revision).to_i)
      end
      check_count!(entries, sorted_revisions)
      entries.collect{|entry| {message: entry['message'], author_date: author_date(entry['time'])}}
    end

    private

    def list(text)
      data = YAML.safe_load(text, permitted_classes: [Date, Time])
      entries = data['revisions'] if data.is_a?(Hash)
      raise Invalid, "#{FILENAME} has no top-level revisions list." unless entries.is_a?(Array)
      entries
    rescue Psych::Exception => e
      raise Invalid, "#{FILENAME} does not parse: #{e.message}"
    end

    def check_entry!(entry, index, number)
      refuse(index, 'is not a mapping') unless entry.is_a?(Hash)
      unless entry['revision'] == number
        refuse(index, "states revision #{entry['revision'].inspect} where the directory at its place is #{number}")
      end
      unless entry['time'].is_a?(String) && author_date(entry['time'])
        refuse(index, "has a time which does not parse: #{entry['time'].inspect}")
      end
      unless entry['message'].is_a?(String) && !entry['message'].strip.empty?
        refuse(index, "has no message")
      end
    end

    def check_count!(entries, sorted_revisions)
      if entries.length > sorted_revisions.length
        refuse(sorted_revisions.length, "has no directory: #{entries.length} entries for #{sorted_revisions.length} revisions")
      elsif entries.length < sorted_revisions.length
        directory = File.basename(sorted_revisions[entries.length])
        raise Invalid, "#{FILENAME}: no entry for directory #{directory}: #{entries.length} entries for #{sorted_revisions.length} revisions."
      end
    end

    def refuse(index, reason)
      raise Invalid, "#{FILENAME}: revisions[#{index}] #{reason}."
    end

    # A bare day is midnight in the local zone, as a CHANGELOG's date is; a full
    # time keeps the zone it states.
    def author_date(time)
      if time =~ DAY
        Date.strptime(time, '%Y-%m-%d').to_time.strftime('%Y-%m-%dT%H:%M:%S%z')
      elsif time =~ TIME
        DateTime.strptime(time, '%Y-%m-%d %H:%M:%S %z').strftime('%Y-%m-%dT%H:%M:%S%z')
      end
    rescue Date::Error
      nil
    end
  end
end

def second_argument?
  !ARGV[1].nil?
end

def revisions_root
  @revisions_root ||= (
    if second_argument?
      if ARGV[1] && File.exist?(ARGV[1])
        File.expand_path(ARGV[1])
      end
    elsif ARGV[0] && File.exist?(ARGV[0])
      File.expand_path(ARGV[0])
    end
  )
end

def revision_directories
  Dir["#{revisions_root}/*"]
    .select{|entry| File.directory?(entry) && File.basename(entry) =~ /\A\d+\z/}
    .sort_by{|entry| File.basename(entry).to_i}
    .map{|entry| File.expand_path(entry)}
end

def repo
  @repo ||= (
    if second_argument?
      if ARGV[0] && File.exist?(ARGV[0])
        File.expand_path(ARGV[0])
      end
    else
      File.expand_path('.')
    end
  )
end

def repository_exist?(repo)
  current_dir = Dir.pwd
  return_value = Dir.exist?(repo) && Dir.chdir(repo) && Dir.exist?('.git')
  Dir.chdir(current_dir)
  return_value
end

def read_changelog(sorted_revisions)
  sorted_revisions.reverse_each do |candidate|
    ['CHANGELOG.md', 'CHANGELOG'].each do |filename|
      changelog_path = File.join(candidate, filename)
      return File.read(changelog_path) if File.exist?(changelog_path)
    end
  end
  nil
end

def revisions_path
  "#{revisions_root}/#{Revisions::FILENAME}"
end

# A revisions.yml takes precedence, and where there is one no CHANGELOG is read.
def entries(sorted_revisions)
  if File.exist?(revisions_path)
    Revisions.parse(File.read(revisions_path), sorted_revisions)
  else
    changelog_entries = Changelog.parse(read_changelog(sorted_revisions))
    check_entry_count!(sorted_revisions, changelog_entries)
    changelog_entries
  end
end

def commit_message(revision_index, entries)
  entry = entries[revision_index]
  if entry.nil?
    "Committed automatically by git-import-all."
  elsif entry[:message]
    entry[:message]
  else
    # An entry stating a version says so in the subject; one stating none takes
    # its summary alone, a subject stating a version being a version.  The date
    # had stood in the version's place, which read as one, and the commit states
    # its date already in its author date.
    entry[:version] ? "#{entry[:version]}: #{entry[:summary]}" : entry[:summary]
  end
end

def commit_date(revision_index, entries)
  entry = entries[revision_index]
  return entry[:author_date] if entry && entry[:author_date]
  return nil unless entry && entry[:date]
  date = Date.parse(entry[:date]) rescue nil
  date&.to_time&.strftime('%Y-%m-%dT%H:%M:%S%z')
end

# The author date is when the work was authored, which a CHANGELOG knows to the
# day, midnight saying the day is known and the hour is not.  The committer date
# is when the commit was made, which is now: stamping it with the CHANGELOG's
# date states that a commit was made upon a day it was not, sometimes years
# earlier.  Left unset, git takes the time of the commit, which is what every
# other rewrite does — filter-branch, rebase, am and cherry-pick each keep the
# author date and take a fresh committer date.
#
# The cost is that an import is no longer reproducible: run twice over the same
# revisions it now yields different commits, where before it yielded the same
# ones.  A switch could have that back where it is ever wanted; a false date by
# default is too much to pay for it.
def commit_environment(revision_index, entries)
  date = commit_date(revision_index, entries)
  return '' unless date
  "GIT_AUTHOR_DATE=#{date} "
end

def check_entry_count!(sorted_revisions, entries)
  return if entries.length == sorted_revisions.length
  raise "#{entries.length} CHANGELOG entries for #{sorted_revisions.length} revisions: " \
    'each revision takes its message from the entry at the same index, so the two must agree.'
end

def replace_contents(repo, revision)
  Dir["#{repo}/*"].each do |filename|
    run "rm -rf #{Shellwords.escape(filename)}", show: true
  end
  Dir["#{revision}/*"].each do |filename|
    run "cp -r #{Shellwords.escape(filename)} #{Shellwords.escape(repo)}", show: true
  end
end

# The message goes in through a file and verbatim, so that a message of several
# lines is committed as written: git's whitespace cleanup would otherwise
# collapse runs of blank lines and strip trailing spaces.  A one-line message,
# which is all a CHANGELOG entry gives, commits the same either way.
def commit(repo, revision_index, entries)
  Tempfile.create('git-import-all') do |message_file|
    message_file.write("#{commit_message(revision_index, entries).chomp}\n")
    message_file.flush
    run "git -C #{Shellwords.escape(repo)} add -A", show: true
    run "#{commit_environment(revision_index, entries)}git -C #{Shellwords.escape(repo)} commit --cleanup=verbatim -F #{Shellwords.escape(message_file.path)}", show: true
  end
end

def main(repo)
  unless repository_exist?(repo)
    $stderr.puts "#{repo} is not a git repository."
    $stderr.puts 'Make one first, with git init or git-boot: this imports into a repository, it does not create one.'
    exit 1
  end
  sorted_revisions = revision_directories
  revision_entries = entries(sorted_revisions)
  sorted_revisions.each_with_index do |revision, index|
    replace_contents(repo, revision)
    commit(repo, index, revision_entries)
  end
rescue Revisions::Invalid => e
  $stderr.puts e.message
  exit 1
end

# Run when run, and not when required, so that the parser may be exercised
# without an import, as git-boot's is.
main(repo) if __FILE__ == $0
