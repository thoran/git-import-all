#!/usr/bin/env ruby
# git-import-all

# 20260320
# 0.5.0

# Changes since 0.4:
# -/0: Rename from git-importall; CHANGELOG-aware commit messages.
# 1. /git-importall/git-import-all/
# 2. + read_changelog()
# 3. + parse_latest_entry()
# 4. + commit_message()
# 5. ~ main(): Use commit_message() instead of generic message.
# 6. - require 'File/self.basename_without_extname': Unused since 0.4.0 when automatic pushing to a remote was removed.

# Notes:
# 1. For the time being this will use the same directory as is used by clone.
# 2. Optionally run changelogger on the revisions root before running this script.

# Todo:
# 1. Accommodate for when there is a local repository, but none remotely, since that is a possibility. (Done as of 0.4.0; essentially by removing any reference to a remote repository at all.)
# 2. Make the output a bit more presentable.
# 3. As per git-boot (to an extent) make this independent of Github and able to be used with other similar services as well as with generic git repo's.  (Done as of 0.4.0 as per Todo #1.)

# Examples:
# 1. cd ~/path/to/repo; git-import-all ~/path/to/revisions/root/
# 2. git-import-all ~/path/to/repo ~/path/to/revisions/root/

require 'Array/natural_sortX'
require 'Dir/self.existQ'
require 'fileutils'
require 'impuri'
require 'Kernel/run'

def second_argument?
  !ARGV[1].nil?
end

def revisions_root
  @revisions_root ||= (
    if second_argument?
      if ARGV[1] && File.exist?(ARGV[1])
        File.expand_path(ARGV[1])
      end
    elsif ARGV[0] && File.exist?(ARGV[0])
      File.expand_path(ARGV[0])
    end
  )
end

def repo
  @repo ||= (
    if second_argument?
      if ARGV[0] && File.exist?(ARGV[0])
        File.expand_path(ARGV[0])
      end
    else
      File.expand_path('.')
    end
  )
end

def repository_exist?(repo)
  current_dir = Dir.pwd
  return_value = Dir.exist?(repo) && Dir.chdir(repo) && Dir.exist?('.git')
  Dir.chdir(current_dir)
  return_value
end

def repo_dir(repo)
  @repo_dir ||= (
    if repository_exist?(repo)
      repo
    end
  )
end

def read_changelog(revision)
  changelog_path = File.join(revision, 'CHANGELOG')
  return nil unless File.exist?(changelog_path)
  File.read(changelog_path)
end

def parse_latest_entry(changelog_text)
  return nil unless changelog_text
  entries = changelog_text.split(/(?=\d+\.\d+\.\d+\s+-\s+\d{8})/)
  entries.reject!{|e| e.strip.empty? || e.strip == '# CHANGELOG'}
  entry = entries.first
  return nil unless entry
  version = nil
  summary = nil
  items = []
  entry.each_line do |line|
    line = line.strip
    if line =~ /\A(\d+\.\d+\.\d+)\s+-\s+\d{8}/
      version = $1
    elsif line =~ /\A\d+\.\s+(.*)/
      items << $1.strip
    elsif line =~ /\A#/
      next
    elsif !line.empty? && summary.nil?
      summary = line
    end
  end
  summary ||= items.first
  version ||= 'unknown'
  summary ||= 'No summary'
  {version: version, summary: summary}
end

def commit_message(revision)
  changelog_text = read_changelog(revision)
  entry = parse_latest_entry(changelog_text)
  if entry
    "#{entry[:version]}: #{entry[:summary]}"
  else
    "Committed automatically by git-import-all."
  end
end

def main(repo)
  unless repository_exist?(repo_dir(repo))
    run "mkdir -p #{repo_dir(repo)}", show: true
    run "cd #{repo_dir(repo)}", show: true
    run "git-boot #{repo}", show: true
  end
  Dir["#{revisions_root}/*"].natural_sort!.each do |revision|
    revision = File.expand_path(revision)
    Dir["#{repo_dir(repo)}/*"].each do |filename|
      run "rm -rf #{filename}", show: true
    end
    Dir["#{revision}/*"].each do |filename|
      run "cp -r #{filename} #{repo_dir(repo)}", show: true
    end
    message = commit_message(revision)
    run 'git add -A', show: true
    run "git commit -m \"#{message}\"", show: true
  end
end

main(repo)
