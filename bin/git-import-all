#!/usr/bin/env ruby
# git-import-all

# 20260804
# 0.8.0

# Changes since 0.7:
# -/0:
# 1. + module Changelog, with Changelog.parse() replacing parse_entries(). Inlined for now; to be
#    extracted to a library once the format set is complete, so that changelogger can share it.
# 2. + Changelog::Format::DatedHeading: "## 20260726" with the version and summary on the body
#    line, which is the style most of the repositories use.
# 3. + Changelog::Format::VersionedHeading: the version in the ## heading, covering the
#    parenthesised, bracketed and em dashed variants.
# 4. + Changelog::Format.for(): Dispatch per entry, requiring exactly one format to match. Nothing
#    matching, or more than one matching, raises rather than silently yielding a wrong message.
# 5. - heading_summary(), parse_entries().

# Notes:
# 1. For the time being this will use the same directory as is used by clone.
# 2. Optionally run changelogger on the revisions root before running this script.

# Todo:
# 1. Accommodate for when there is a local repository, but none remotely, since that is a possibility. (Done as of 0.4.0; essentially by removing any reference to a remote repository at all.)
# 2. Make the output a bit more presentable.
# 3. As per git-boot (to an extent) make this independent of Github and able to be used with other similar services as well as with generic git repo's.  (Done as of 0.4.0 as per Todo #1.)

# Examples:
# 1. cd ~/path/to/repo; git-import-all ~/path/to/revisions/root/
# 2. git-import-all ~/path/to/repo ~/path/to/revisions/root/

require 'Array/natural_sortX'
require 'Dir/self.existQ'
require 'fileutils'
require 'impuri'
require 'Kernel/run'

module Changelog
  ITEM = /\A\d+\.\s+(.*)\z/
  VERSION = /\[?v?(\d+(?:\.\d+)+)\]?/
  DATE = /(\d{4}-?\d{2}-?\d{2})/

  module Format
    module Common
      def heading(text)
        text.lines.first.to_s.strip
      end

      def body_lines(text)
        text.lines.drop(1).map(&:strip)
      end

      def items(text)
        body_lines(text).map{|line| line[Changelog::ITEM, 1]}.compact
      end

      def entry(version, date, summary, text)
        {version: version, date: date, summary: summary || items(text).first || 'No summary'}
      end
    end

    module DatedHeading
      extend Common

      BOUNDARY = /^##\s+\d{8}\s*$/
      HEADING = /\A##\s+(\d{8})\s*\z/
      VERSIONED_SUMMARY = /\A(\d+(?:\.\d+)+):\s*(.*)\z/

      class << self
        def key
          :dated_heading
        end

        def matches?(text)
          !(heading(text) =~ HEADING).nil?
        end

        def parse(text)
          version = nil
          summary = nil
          body_lines(text).each do |line|
            next if line.empty? || line =~ Changelog::ITEM || line.start_with?('#')
            if line =~ VERSIONED_SUMMARY
              version = $1
              summary = $2.strip
            else
              summary = line
            end
            break
          end
          entry(version, heading(text)[HEADING, 1], summary, text)
        end
      end
    end

    module VersionedHeading
      extend Common

      BOUNDARY = /^##\s+\[?v?\d+(?:\.\d+)+/

      class << self
        def key
          :versioned_heading
        end

        def matches?(text)
          line = heading(text)
          line.start_with?('##') && !line[Changelog::VERSION, 1].nil?
        end

        def parse(text)
          line = heading(text).sub(/\A##\s+/, '')
          version = line[Changelog::VERSION, 1]
          date = line[Changelog::DATE, 1]
          entry(version, date, summary(line, version, date) || trailing_summary(text), text)
        end

        private

        def summary(line, version, date)
          result = line.dup
          result.sub!(/\[?v?#{Regexp.escape(version)}\]?/, '') if version
          result.sub!(/\(?#{Regexp.escape(date)}\)?/, '') if date
          result.sub!(/\A[\s\-—\/(),:]+/, '')
          result.strip.empty? ? nil : result.strip
        end

        def trailing_summary(text)
          line = body_lines(text).detect{|candidate| !candidate.empty? && !(candidate =~ Changelog::ITEM)}
          line ? line.sub(/\A#+\s*/, '').strip[/.+/] : nil
        end
      end
    end

    class << self
      def all
        [DatedHeading, VersionedHeading]
      end

      def boundary
        @boundary ||= Regexp.new("(?=#{all.map{|format| format::BOUNDARY.source}.join('|')})")
      end

      def for(text)
        matched = all.select{|format| format.matches?(text)}
        line = text.lines.first.to_s.strip
        raise "No CHANGELOG format matches: #{line}" if matched.empty?
        raise "Ambiguous CHANGELOG format (#{matched.map(&:key).join(', ')}): #{line}" if matched.length > 1
        matched.first
      end
    end
  end

  class << self
    def parse(text)
      return [] unless text
      chunks(text).reverse.map{|chunk| Format.for(chunk).parse(chunk)}
    end

    private

    def chunks(text)
      result = text.split(Format.boundary).reject{|chunk| chunk.strip.empty?}
      result.shift unless result.empty? || matched?(result.first)
      raise 'No CHANGELOG entries recognised.' if result.empty?
      result
    end

    def matched?(chunk)
      Format.all.any?{|format| format.matches?(chunk)}
    end
  end
end

def second_argument?
  !ARGV[1].nil?
end

def revisions_root
  @revisions_root ||= (
    if second_argument?
      if ARGV[1] && File.exist?(ARGV[1])
        File.expand_path(ARGV[1])
      end
    elsif ARGV[0] && File.exist?(ARGV[0])
      File.expand_path(ARGV[0])
    end
  )
end

def repo
  @repo ||= (
    if second_argument?
      if ARGV[0] && File.exist?(ARGV[0])
        File.expand_path(ARGV[0])
      end
    else
      File.expand_path('.')
    end
  )
end

def repository_exist?(repo)
  current_dir = Dir.pwd
  return_value = Dir.exist?(repo) && Dir.chdir(repo) && Dir.exist?('.git')
  Dir.chdir(current_dir)
  return_value
end

def repo_dir(repo)
  @repo_dir ||= (
    if repository_exist?(repo)
      repo
    end
  )
end

def read_changelog(sorted_revisions)
  sorted_revisions.reverse_each do |candidate|
    ['CHANGELOG.md', 'CHANGELOG'].each do |filename|
      changelog_path = File.join(candidate, filename)
      return File.read(changelog_path) if File.exist?(changelog_path)
    end
  end
  nil
end

def commit_message(revision_index, entries)
  entry = entries[revision_index]
  if entry
    prefix = entry[:version] || entry[:date]
    if prefix
      "#{prefix}: #{entry[:summary]}"
    else
      entry[:summary]
    end
  else
    "Committed automatically by git-import-all."
  end
end

def main(repo)
  unless repository_exist?(repo_dir(repo))
    run "mkdir -p #{repo_dir(repo)}", show: true
    run "cd #{repo_dir(repo)}", show: true
    run "git-boot #{repo}", show: true
  end
  sorted_revisions = Dir["#{revisions_root}/*"].natural_sort!.map{|r| File.expand_path(r)}
  changelog_text = read_changelog(sorted_revisions)
  entries = Changelog.parse(changelog_text)
  sorted_revisions.each_with_index do |revision, index|
    Dir["#{repo_dir(repo)}/*"].each do |filename|
      run "rm -rf #{filename}", show: true
    end
    Dir["#{revision}/*"].each do |filename|
      run "cp -r #{filename} #{repo_dir(repo)}", show: true
    end
    message = commit_message(index, entries)
    run 'git add -A', show: true
    run "git commit -m \"#{message}\"", show: true
  end
end

main(repo)
