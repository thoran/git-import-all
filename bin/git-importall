#!/usr/bin/env ruby
# git-importall

# 20140510
# 0.0.7

require 'Array/natural_sortX'
require 'fileutils'

revisions_root = File.expand_path(ARGV[0])
repo_dir = File.expand_path(ARGV[1])

puts "cd #{repo_dir}"
Dir.chdir(repo_dir)

Dir["#{revisions_root}/*"].natural_sort!.each do |revision|
  revision = File.expand_path(revision)

  Dir["#{repo_dir}/**/*"].each do |filename|
    puts "rm -f #{filename}"
    FileUtils.rm_f(filename)
  end

  Dir["#{revision}/*"].each do |filename|
    puts "cp -r #{filename} #{repo_dir}"
    FileUtils.cp_r(filename, repo_dir)
  end

  puts 'git add .'
  system 'git add .'

  puts 'git commit'
  system 'git commit'
end

puts 'git push'
system 'git push'
