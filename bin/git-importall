#!/usr/bin/env ruby
# git-importall

# 20140508
# 0.0.1

require 'Array/natural_sortX'
require 'fileutils'

revisions_root = File.expand_path(ARG[0])
repo_dir = File.expand_path(ARG[1])

Dir.chdir(repo_dir)

Dir["#{revisions_root}/*"].natural_sort!.each do |revision|
  revision = File.expand_path(revision)
  FileUtils.cp_pr(revision, repo_dir)
  system 'git commit -a'
end
