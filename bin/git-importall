#!/usr/bin/env ruby
# git-importall

# 20141220
# 0.2.2

# Changes:
# 0/1
# 1. ~ revisions_root(), so that it first checks for the existence of ARGV[0] and that it is a file and then assigns '.' if it is missing.
# 2. ~ repo(), so that it first checks for the existence of ARGV[1] and then assigns ARGV[0] if it is missing.
# 3. ~ local_repository_exist?(), since it was chdir'ing to the repo and the revisions root, which is otherwise the default pwd is being lost.
# 1/2
# 4. Removed any diagnostic output.

# Discussion:
# 1. How is the situation of an existing local repository handled if the remote one does not exist?

# Notes:
# 1. For the time being this will use the same directory as is used by clone.

# Todo:
# 1. Accommodate for when there is a local repository, but none remotely, since that is a possibility.
# 2. Make the output a bit more presentable.
# 3. As per git-boot (to an extent) make this independent of Github and able to be used with other similar services as well as with generic git repo's.

require 'Array/natural_sortX'
require 'Dir/self.existQ'
require 'fileutils'
require 'File/self.basename_without_extname'
require 'ImpURI'
require 'octokit'

# Retrieves GITHUB_REPOS_DIR---the preferred location of local github repositories.
require File.expand_path('~/.config/clone_from_github/config.rb')

def revisions_root
  @revisions_root ||= (
    if ARGV[0] && File.exist?(ARGV[0])
      File.expand_path(ARGV[0])
    else
      File.expand_path('.')
    end
  )
end

def repo
  @repo ||= (
    if ARGV[1] && ImpURI.parse(ARGV[1]).hostname?
      ARGV[1]
    elsif ARGV[0] && ImpURI.parse(ARGV[0]).hostname?
      ARGV[0]
    end
  )
end

def local_repository_exist?(repo)
  current_dir = Dir.pwd
  return_value = Dir.exist?(repo) && Dir.chdir(repo) && Dir.exist?('.git')
  Dir.chdir(current_dir)
  return_value
end

def repo_remote?(repo)
  ImpURI.parse(repo).hostname?
end

def remote_repository_exist?(repo)
  if repo_remote?(repo)
    impuri = ImpURI.new(repo)
    octokit_client = Octokit::Client.new(login: impuri.username, password: impuri.password)
    repo = octokit_client.repos.detect{|repo| impuri.path =~ Regexp.new(Regexp.quote(repo[:full_name]))}
    repo ? true : false
  else
    Dir.exist?('.git') && system('git ls-remote') && $?.success?
  end
end

def repo_remote_and_exist?(repo)
  repo_remote?(repo) && remote_repository_exist?(repo)
end

def repo_dir(repo)
  @repo_dir ||= (
    if local_repository_exist?(repo)
      repo
    else
      full_github_repos_dir = File.expand_path(GITHUB_REPOS_DIR)
      impuri = ImpURI.parse(repo)
      username = impuri.username
      repo_sans_extname = File.basename_without_extname(impuri.path)
      File.join(full_github_repos_dir, username, repo_sans_extname)
    end
  )
end

def main
  if remote_repository_exist?(repo)
    unless local_repository_exist?(repo_dir(repo))
      impuri = ImpURI.new(repo)
      puts "git clone git@github.com:#{impuri.path}.git"
      system "git clone git@github.com:#{impuri.path}.git"
    end
  else
    unless local_repository_exist?(repo_dir(repo))
      puts "mkdir -p #{repo_dir(repo)}"
      FileUtils.mkdir_p(repo_dir(repo))
      puts "cd #{repo_dir(repo)}"
      Dir.chdir(repo_dir(repo))
      system "git-boot #{repo}"      
    end
  end
  Dir["#{revisions_root}/*"].natural_sort!.each do |revision|
    revision = File.expand_path(revision)

    Dir["#{repo_dir(repo)}/*"].each do |filename|
      puts "rm -rf #{filename}"
      FileUtils.rm_rf(filename)
    end

    Dir["#{revision}/*"].each do |filename|
      puts "cp -r #{filename} #{repo_dir(repo)}"
      FileUtils.cp_r(filename, repo_dir(repo))
    end

    puts 'git add -A .'
    system 'git add -A .'

    puts 'git commit -m "Committed automatically by git-importall."'
    system 'git commit -m "Committed automatically by git-importall."'
  end

  puts 'git push origin master'
  system 'git push origin master'
end

main
