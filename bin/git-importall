#!/usr/bin/env ruby
# git-importall

# 20140510
# 0.0.2

require 'Array/natural_sortX'
require 'fileutils'

revisions_root = File.expand_path(ARGV[0])
repo_dir = File.expand_path(ARGV[1])

puts "cd #{repo_dir}"
Dir.chdir(repo_dir)

Dir["#{revisions_root}/*"].natural_sort!.each do |revision|
  revision = File.expand_path(revision)
  puts "cp -pr #{revision} #{repo_dir}"
  FileUtils.cp_pr(revision, repo_dir)
  puts 'git commit -a'
  #system 'git commit -a'
end
