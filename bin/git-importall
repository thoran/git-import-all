#!/usr/bin/env ruby
# git-importall

# 20200208
# 0.4.0

# Changes: (Making it work locally only, since we have git push for the other bit!)
# 1. Added the impuri gem.
# 2. - require 'octokit'
# 3. + second_argument()
# 4. - repo_remote?()
# 5. - remote_repository_exist?()
# 6. - repo_remote_and_exist?()
# 7. /local_repository_exist?()/repository_exist?()/
# 8. ~ main(), so that it no longer attempts to push.
# 9. ~ main(), so that it accepts the repo argument, thereby making a bit more functional, while I don't have explicit objects in here.

# Discussion:
# 1. How is the situation of an existing local repository handled if the remote one does not exist?

# Notes:
# 1. For the time being this will use the same directory as is used by clone.

# Todo:
# 1. Accommodate for when there is a local repository, but none remotely, since that is a possibility. (Done as of 0.4.0; essentially by removing any reference to a remote repository at all.)
# 2. Make the output a bit more presentable.
# 3. As per git-boot (to an extent) make this independent of Github and able to be used with other similar services as well as with generic git repo's.  (Done as of 0.4.0 as per Todo #1.)

# Examples:
# 1. cd ~/path/to/repo; git-importall ~/path/to/revisions/root/
# 2. git-importall ~/path/to/repo ~/path/to/revisions/root/

require 'Array/natural_sortX'
require 'Dir/self.existQ'
require 'fileutils'
require 'File/self.basename_without_extname'
require 'ImpURI'
require 'Kernel/run'

def second_argument?
  !ARGV[1].nil?
end

def revisions_root
  @revisions_root ||= (
    if second_argument?
      if ARGV[1] && File.exist?(ARGV[1])
        File.expand_path(ARGV[1])
      end
    elsif ARGV[0] && File.exist?(ARGV[0])
      File.expand_path(ARGV[0])
    end
  )
end

def repo
  @repo ||= (
    if second_argument?
      if ARGV[0] && File.exist?(ARGV[0])
        File.expand_path(ARGV[0])
      end
    else
      File.expand_path('.')
    end
  )
end

def repository_exist?(repo)
  current_dir = Dir.pwd
  return_value = Dir.exist?(repo) && Dir.chdir(repo) && Dir.exist?('.git')
  Dir.chdir(current_dir)
  return_value
end

def repo_dir(repo)
  @repo_dir ||= (
    if repository_exist?(repo)
      repo
    end
  )
end

def main(repo)
  unless repository_exist?(repo_dir(repo))
    run "mkdir -p #{repo_dir(repo)}", show: true
    run "cd #{repo_dir(repo)}", show: true
    run "git-boot #{repo}", show: true
  end

  Dir["#{revisions_root}/*"].natural_sort!.each do |revision|
    revision = File.expand_path(revision)
    Dir["#{repo_dir(repo)}/*"].each do |filename|
      run "rm -rf #{filename}", show: true
    end
    Dir["#{revision}/*"].each do |filename|
      run "cp -r #{filename} #{repo_dir(repo)}", show: true
    end
    run 'git add -A', show: true
    run 'git commit -m "Committed automatically by git-importall."', show: true
  end
end

main(repo)
